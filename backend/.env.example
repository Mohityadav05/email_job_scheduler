# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="mysql://reachinbox:reachinboxpass@localhost:3306/reachinbox"
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=reachinbox
MYSQL_USER=reachinbox
MYSQL_PASSWORD=reachinboxpass

# Redis
REDIS_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Ethereal SMTP senders (comma-separated JSON array)
# Generate accounts at https://ethereal.email/create
# Format: [{"id":"sender1","user":"user@ethereal.email","pass":"password","host":"smtp.ethereal.email","port":587}]
SMTP_SENDERS='[{"id":"sender1","user":"your@ethereal.email","pass":"yourpass","host":"smtp.ethereal.email","port":587}]'

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Session (used briefly during OAuth flow)
SESSION_SECRET=change-this-too

# Frontend URL (for OAuth redirect and CORS)
FRONTEND_URL=http://localhost:3000

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Slack OAuth
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/auth/slack/callback
